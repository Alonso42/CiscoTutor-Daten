                                            "kopf":  [
                                                         "Befehl",
                                                         "Zweck"
                                                     ],
                                            "zeilen":  [
                                                           [
                                                               "show mac address-table [interface | address | vlan]",
                                                               "Einträge anzeigen und filtern"
                                                           ],
                                                           [
                                                               "show mac address-table aging-time",
                                                               "Aging global und pro VLAN (Default 300 s)"
                                                           ],
